{
  "name": "nix-s3-action",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "nix-build with the help of caching to S3",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "tsc --noEmit && ncc build -o dist/main --target es2023 src/main.ts",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nix-ocaml/nix-s3-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Domen Kožar, Ulrik Strid",
  "license": "ASL2",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^6.0.3"
  }
}
